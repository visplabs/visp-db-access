VISP_GATE_DATABASE_URL=postgres://vda:REPLACE_ME@metadata:5432/vda
# Generate independently; keep stable and backed up. Required, no default.
VISP_GATE_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
VISP_GATE_BIND=0.0.0.0:8080
VISP_GATE_METADATA_POOL_SIZE=20
VISP_GATE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
VISP_GATE_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
VISP_GATE_COOKIE_SECURE=true
VISP_GATE_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16
VISP_GATE_TRUST_PROXY_HEADERS=true
# Only actual reverse-proxy source networks, never arbitrary client networks.
VISP_GATE_TRUSTED_PROXY_CIDRS=10.42.0.0/16
VISP_GATE_ALLOW_PRIVATE_TARGETS=false
# The address people open the console at. Notices link to a request only when set.
VISP_GATE_PUBLIC_URL=https://gate.example.com
# Days the record of agent steps (tool, task, SQL text; never rows) is kept.
VISP_GATE_AGENT_STEPS_RETENTION_DAYS=30
# Memory per node, and per agent, for rows held for the agent tool fetch_rows.
VISP_GATE_HELD_RESULTS_MAX_BYTES=268435456
VISP_GATE_HELD_RESULTS_AGENT_MAX_BYTES=67108864
VISP_GATE_LOG_FORMAT=json
RUST_LOG=info
