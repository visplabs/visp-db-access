# Metadata store (Postgres). Stores users, clusters, policies, audit logs.
VISP_GATE_DATABASE_URL=postgres://vda:vda@localhost:5432/vda
# 32-byte key, base64. Encrypts target database credentials at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
VISP_GATE_MASTER_KEY=
VISP_GATE_BIND=0.0.0.0:8080
VISP_GATE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
VISP_GATE_BOOTSTRAP_ADMIN_PASSWORD=change-me-please
VISP_GATE_COOKIE_SECURE=false
# Comma-separated CIDRs allowed to reach the console. Empty = allow all.
VISP_GATE_ALLOWED_CIDRS=
VISP_GATE_TRUST_PROXY_HEADERS=false
RUST_LOG=info,vda_server=debug
